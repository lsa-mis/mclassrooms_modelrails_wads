# Generated by bin/rails required_production_config:generate. Don't edit.
# Describes what production needs. Values go in credentials, deploy.yml or fnox; never here.

# secret_key_base: required. Get it: Written by credentials:edit when it creates the file. Set it: bin/rails credentials:edit --environment production
# secret_key_base: written by bin/rails credentials:edit when it creates the file; leave it as it is

# smtp.user_name: required. Get it: Your mail provider; for Postmark, the Server API token under Servers → your server → API Tokens. Set it: bin/rails credentials:edit --environment production
# smtp.password: required. Get it: Your mail provider; for Postmark, the Server API token under Servers → your server → API Tokens. Set it: bin/rails credentials:edit --environment production
# smtp:
#   user_name: <from Postmark → Servers → API Tokens>
#   password: <from Postmark → Servers → API Tokens>

# active_record_encryption.primary_key: required. Get it: bin/encryption-setup makes all three and stores them only in the production credentials; by hand, bin/rails db:encryption:init prints them once. Set it: bin/encryption-setup, or by hand bin/rails credentials:edit --environment production
# active_record_encryption.deterministic_key: required. Get it: bin/encryption-setup makes all three and stores them only in the production credentials; by hand, bin/rails db:encryption:init prints them once. Set it: bin/encryption-setup, or by hand bin/rails credentials:edit --environment production
# active_record_encryption.key_derivation_salt: required. Get it: bin/encryption-setup makes all three and stores them only in the production credentials; by hand, bin/rails db:encryption:init prints them once. Set it: bin/encryption-setup, or by hand bin/rails credentials:edit --environment production
# active_record_encryption: run bin/encryption-setup, which adds this block

# mailer.from: optional. Get it: Your choice of sender address. Set it: bin/rails credentials:edit --environment production
# mailer:
#   from: <your sender address, such as hello@yourdomain.com>

# oauth.google.client_id: optional. Get it: A google oauth client (OAuth Setup in getting-started). Set it: bin/rails credentials:edit --environment production
# oauth.google.client_secret: required when oauth.google.client_id is set. Get it: A google oauth client (OAuth Setup in getting-started). Set it: bin/rails credentials:edit --environment production
# oauth.github.client_id: optional. Get it: A github oauth app (OAuth Setup in getting-started). Set it: bin/rails credentials:edit --environment production
# oauth.github.client_secret: required when oauth.github.client_id is set. Get it: A github oauth app (OAuth Setup in getting-started). Set it: bin/rails credentials:edit --environment production
# oauth:
#   google:
#     client_id: <from Google → OAuth client id>
#     client_secret: <from Google → OAuth client secret>
#   github:
#     client_id: <from GitHub → OAuth client id>
#     client_secret: <from GitHub → OAuth client secret>

# object_storage.access_key_id: required when OBJECT_STORAGE_BUCKET is set. Get it: Your backup bucket's provider. Set it: bin/rails credentials:edit --environment production
# object_storage.secret_access_key: required when OBJECT_STORAGE_BUCKET is set. Get it: Your backup bucket's provider. Set it: bin/rails credentials:edit --environment production
# object_storage:
#   access_key_id: <from your bucket provider → access key id>
#   secret_access_key: <from your bucket provider → secret access key>
