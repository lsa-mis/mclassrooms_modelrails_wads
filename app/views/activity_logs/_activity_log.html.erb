<%# locals: (activity_log:, context: nil) -%>
<%# context is prepared markup (a link, or plain text) naming where the row
    happened — the cross-workspace operations feed needs it, the workspace and
    project feeds pass nothing and render exactly as before. It lives inside
    this <li> because the row IS the list item: a caller that wraps this
    partial to add its own context makes every entry a nested one-item list. -%>
<li class="flex items-start gap-3 text-sm">
  <div class="flex-1">
    <% if context %>
      <div class="font-medium text-text-heading"><%= context %></div>
    <% end %>
    <span class="font-medium text-text-heading">
      <%= activity_log.display_subject || t("activity.system") %>
    </span>
    <span class="text-text-muted">
      <%= t("activity.actions.#{activity_log.display_action}",
             member: activity_log.display_member || t("activity.unknown_member")) %>
    </span>
  </div>
  <time datetime="<%= activity_log.created_at.iso8601 %>"
        class="text-xs text-text-muted whitespace-nowrap">
    <%= time_ago_in_words(activity_log.created_at) %> <%= t("activity.ago") %>
  </time>
</li>
