<% content_for(:title) { t(".title") } %>

<div class="page-container">
  <h1 class="text-2xl font-bold text-text-heading">
    <%= t(".title") %>
  </h1>

  <p class="mt-4 text-text-body">
    <%= t(".prompt", email: @authentication.email, provider: @authentication.display_provider) %>
  </p>

  <div class="mt-8 flex items-center gap-3">
    <%= button_to t(".button", email: @authentication.email, provider: @authentication.display_provider),
          settings_connected_account_verification_path,
          method: :post,
          params: { token: @token },
          class: "btn-primary" %>

    <%# Reachable both signed in (linking a new provider) and signed out (the
        deferred unverified-OAuth signup path) — root_path resolves correctly
        either way, unlike settings_connected_accounts_path which requires
        authentication. %>
    <%= link_to t(".cancel"), root_path,
          class: "btn-text text-sm" %>
  </div>
</div>
