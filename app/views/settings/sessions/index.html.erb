<% content_for(:title) { t("settings.sessions.index.title") } %>
<div class="page-container">
  <%= render "shared/settings_page_header",
        title: t("settings.sessions.index.title"),
        description: t("settings.sessions.index.description") %>

  <ul role="list" class="mt-8 space-y-4">
    <% @sessions.each do |session| %>
      <% current = session.id == Current.session.id %>
      <%# Single-column stack below lg (#768): the settings sidebar appears at
          md, leaving ~470px of content at 768 — side-by-side there crushed
          the title to one word per line. Columns only from lg (~730px of
          content), with gap-x-6 as the real gutter; nothing is shrink-0, so
          the helper text wraps instead of squeezing its neighbor. %>
      <li class="flex flex-col gap-3 p-4 border border-border rounded-lg lg:flex-row lg:items-center lg:justify-between lg:gap-x-6">
        <div class="min-w-0">
          <p class="font-medium text-text-heading">
            <%= session.device_label %>
            <% if current %>
              <span class="sr-only"><%= t("settings.sessions.index.current_device") %>. </span>
              <%= ui :badge, t("settings.sessions.index.current_device"),
                    variant: :soft, tone: :success, class: "ml-2", "aria-hidden": "true" %>
            <% end %>
          </p>
          <p class="text-sm text-text-muted">
            <%= session.ip_address %> &middot; <%# erblint:disable HardCodedString - presentational glyph, not language (#498) %>
            <%= t("settings.sessions.index.last_active", time: time_ago_in_words(session.last_active_at || session.created_at)) %>
          </p>
        </div>

        <div class="action-group">
          <% if current %>
            <p id="session-<%= session.id %>-current" class="text-sm text-text-muted">
              <%= t("settings.sessions.index.current_device_note") %>
            </p>
          <% else %>
            <div data-controller="modal" class="inline">
              <button type="button"
                      class="btn-touch-target btn-text btn-text-danger text-sm focus-ring"
                      aria-label="<%= t("settings.sessions.index.revoke_aria_label", device: session.device_label, time: time_ago_in_words(session.last_active_at || session.created_at)) %>"
                      data-action="click->modal#open">
                <%= t("settings.sessions.index.revoke_button") %>
              </button>
              <%= render "shared/confirm_dialog",
                        title: t("settings.sessions.index.revoke_title"),
                        message: t("settings.sessions.index.revoke_message"),
                        confirm_text: t("settings.sessions.index.revoke_button"),
                        confirm_url: settings_session_path(session),
                        confirm_method: :delete,
                        variant: :danger %>
            </div>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @sessions.count { |s| s.id != Current.session.id }.positive? %>
    <div class="mt-6" data-controller="modal">
      <button type="button"
              class="btn-secondary btn-touch-target"
              data-action="click->modal#open">
        <%= t("settings.sessions.index.sign_out_others_button") %>
      </button>
      <%= render "shared/confirm_dialog",
                title: t("settings.sessions.index.sign_out_others_title"),
                message: t("settings.sessions.index.sign_out_others_message"),
                confirm_text: t("settings.sessions.index.sign_out_others_button"),
                confirm_url: settings_other_sessions_path,
                confirm_method: :delete,
                variant: :danger %>
    </div>
  <% end %>
</div>
