<% content_for(:title) { t("settings.passwords.new.title") } %>
<div class="page-container">
  <%= render "shared/settings_page_header",
        title: t("settings.passwords.new.title"),
        description: t("settings.passwords.new.instructions") %>

  <%= form_with model: Current.user, url: settings_password_path, method: :post, class: "mt-8 space-y-6" do |form| %>
    <%= form.error_summary %>

    <%= form.password_field :password,
          label: t("settings.passwords.new.password_label"),
          required: true,
          autocomplete: "new-password",
          help: t("settings.passwords.new.password_hint") %>

    <%= form.password_field :password_confirmation,
          label: t("settings.passwords.new.password_confirmation_label"),
          required: true,
          autocomplete: "new-password" %>

    <%= form.submit t("settings.passwords.new.submit"), class: "btn-primary w-full" %>
  <% end %>
</div>
