<%
  prefs_object = @preferences.notification_preferences_object
  prefs = @preferences.notification_preferences
%>
<section class="max-w-3xl mx-auto px-4 py-8 space-y-6
                sm:px-6
                lg:px-8">
  <%= render "shared/settings_page_header",
        title: t("settings.pages.notifications.h1"),
        description: t("settings.pages.notifications.description") %>

  <%# === Timezone surface (Phase 0.5) ================================
      The <details>-based drawer + form lives in its own partial so the
      update.turbo_stream response from TimezonesController can replace
      it whole — closing the drawer + refreshing the summary value in
      one operation, without a page reload. -%>
  <%= render "timezone_surface", preferences: @preferences %>

  <%= render "types_card", prefs: prefs %>
  <%= render "delivery_card", prefs: prefs %>
  <%= render "quiet_hours_card", prefs: prefs %>
  <%= render "advanced_card", prefs_object: prefs_object %>
</section>
