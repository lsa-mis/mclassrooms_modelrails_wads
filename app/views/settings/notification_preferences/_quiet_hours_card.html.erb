<%# locals: (prefs:) -%>
<%# Custom layout (not _preferences_row): the toggle + time inputs
    + reassurance text flow together as one configuration cluster. -%>
<%= render layout: "shared/preferences_card",
      locals: {
        title: t("notifications.preferences.quiet_hours.heading"),
        description: t("notifications.preferences.quiet_hours.description")
      } do %>
  <%# `quiet-hours-warning` Stimulus controller watches the enabled toggle
      + day chips inside this scope; surfaces the empty-days warning <p>
      when QH is enabled but no days are checked (a deceptive state — the
      value object treats it as quiet-hours-never-active). -%>
  <div class="px-6 py-5 space-y-4"
       data-controller="quiet-hours-warning">
    <%# The server renders the warning's initial visibility rather than
        shipping it hidden for Stimulus to correct on connect: a user whose
        JS is slow or blocked otherwise sees no warning at all in the one
        state it exists for. NotificationPreferences#quiet_hours_deceptive?
        is the single owner of the condition; the controller maintains it
        live from the same rule. -%>
    <% quiet_hours_deceptive = NotificationPreferences.new(prefs).quiet_hours_deceptive? %>
    <%= form_with url: settings_notification_preferences_path,
          method: :patch,
          data: { controller: "auto-submit" } do |f| %>
      <%= render "shared/toggle",
            name: "notification_preferences[quiet_hours][enabled]",
            label: t("notifications.preferences.quiet_hours.enabled_label"),
            checked: prefs.dig("quiet_hours", "enabled") == true %>
    <% end %>

    <%= form_with url: settings_notification_preferences_path,
          method: :patch,
          data: { controller: "auto-submit" },
          class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div>
        <label for="quiet-hours-start"
               class="block text-sm font-medium text-text-heading mb-2">
          <%= t("notifications.preferences.quiet_hours.start_label") %>
        </label>
        <input type="time"
               id="quiet-hours-start"
               name="notification_preferences[quiet_hours][start]"
               value="<%= prefs.dig("quiet_hours", "start") || "22:00" %>"
               autocomplete="off"
               data-action="change->auto-submit#submit"
               class="form-input">
      </div>
      <div>
        <label for="quiet-hours-end"
               class="block text-sm font-medium text-text-heading mb-2">
          <%= t("notifications.preferences.quiet_hours.end_label") %>
        </label>
        <input type="time"
               id="quiet-hours-end"
               name="notification_preferences[quiet_hours][end]"
               value="<%= prefs.dig("quiet_hours", "end") || "07:00" %>"
               autocomplete="off"
               data-action="change->auto-submit#submit"
               class="form-input">
      </div>
    <% end %>

    <%# Active-days picker: which weekdays the QH window applies on.
        Missing active_days key on a user's row (legacy data) is treated as
        all-7-days by the value object; render as all-checked here too so
        the displayed state matches runtime behavior. The component emits
        the ""-value sentinel itself, so active_days is always submitted as
        an array (zero boxes checked still reaches the controller as
        `active_days=[""]`, which strips down to `[]`).

        No <fieldset> around this: the component IS the group (role=group),
        and wrapping it in a second grouping container makes a reader
        announce the same set twice. It takes its name from the visible
        label and points at the empty-days warning itself, so SR users
        entering the group hear the explanation when the deceptive state is
        active.

        auto-submit is wired once on the form rather than on each chip:
        `change` bubbles, and the controller resolves the form from
        event.target. -%>
    <% current_active = prefs.dig("quiet_hours", "active_days") || NotificationPreferences::DAYS_OF_WEEK %>
    <div>
      <p id="quiet-hours-active-days-label"
         class="text-sm font-medium text-text-heading mb-2">
        <%= t("notifications.preferences.quiet_hours.active_days_label") %>
      </p>
      <%= form_with url: settings_notification_preferences_path,
            method: :patch,
            data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
        <%= ui :chip_group,
               name: "notification_preferences[quiet_hours][active_days]",
               labelledby: "quiet-hours-active-days-label",
               describedby: "quiet-hours-empty-days-warning",
               items: NotificationPreferences::DAYS_OF_WEEK.map { |day|
                 {
                   value: day,
                   label: t("notifications.preferences.quiet_hours.days.#{day}"),
                   aria_label: t("notifications.preferences.quiet_hours.days_full.#{day}"),
                   checked: current_active.include?(day)
                 }
               } %>
      <% end %>
    </div>

    <%# Deceptive-state warning: surfaced by `quiet-hours-warning` Stimulus
        controller when QH is enabled but no days are checked. Initial
        `hidden` class is removed on connect() if the server-rendered
        state is already deceptive.
        The role=status/aria-live region is the STABLE wrapper, not the
        toggled <p>: a live region that itself flips display:none→block pops
        into the a11y tree and announces unreliably. Keeping the region
        always-present means the inner <p>'s text appearing is spoken. -%>
    <div role="status" aria-live="polite">
      <p id="quiet-hours-empty-days-warning"
         class="<%= class_names("text-xs", "text-warning", "hidden" => !quiet_hours_deceptive) %>"
         data-quiet-hours-warning-target="warning">
        <%= t("notifications.preferences.quiet_hours.empty_days_warning") %>
      </p>
    </div>

    <%# Security reassurance is FIXED TEXT per spec decision #6 — not a
        toggle, because security always bypasses quiet_hours and a toggle
        without runtime effect would be deceptive UI. -%>
    <p class="text-xs text-text-muted">
      <%= t("notifications.preferences.quiet_hours.security_reassurance") %>
    </p>
  </div>
<% end %>
