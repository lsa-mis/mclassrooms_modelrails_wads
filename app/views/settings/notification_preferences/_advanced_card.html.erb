<%# locals: (prefs_object:) -%>
<%= render layout: "shared/preferences_card",
      locals: { title: t("notifications.preferences.advanced.heading") } do %>
  <div class="px-6 py-5 space-y-4">
    <%# form.select (#732): the FormBuilder's enhanced path supplies the
        label association, ui-select chrome and aria wiring the raw <select>
        hand-rolled. auto-submit still rides a real native select's change. %>
    <%= form_with url: settings_notification_preferences_path,
          scope: :notification_preferences,
          method: :patch,
          data: { controller: "auto-submit" },
          class: "flex flex-wrap items-center gap-3" do |f| %>
      <%= f.select :retention_days,
            options_for_select(
              [ 30, 60, 90, 180, 365 ].map { |days| [ t("notifications.preferences.advanced.retention_options.#{days}"), days ] } +
                [ [ t("notifications.preferences.advanced.retention_options.never"), "" ] ],
              prefs_object.retention_days
            ),
            { label: t("notifications.preferences.advanced.retention_label") },
            id: "retention-days",
            autocomplete: "off",
            data: { action: "change->auto-submit#submit" } %>
    <% end %>
    <p class="text-xs text-text-muted">
      <%= t("notifications.preferences.advanced.retention_help") %>
    </p>
  </div>
<% end %>
