<%# locals: (latest:, inventory:) %>
<div class="grid gap-4 md:grid-cols-2">
  <%= ui :card, data: { sync_run_latest: true } do %>
    <%= ui :card_header do %>
      <%= ui :card_title, t("sync_runs.latest.title"), level: 2 %>
    <% end %>
    <%= ui :card_content do %>
      <% if latest %>
        <div class="flex flex-wrap items-center gap-2">
          <%= sync_run_status_badge(latest) %>
          <% if latest.dry_run? %>
            <%= ui :badge, t("sync_runs.dry_run"), variant: :outline, tone: :neutral %>
          <% end %>
        </div>
        <dl class="mt-4 grid grid-cols-[max-content_1fr] gap-x-8 gap-y-2 text-sm">
          <dt class="text-text-muted"><%= t("sync_runs.columns.started") %></dt>
          <dd class="text-text-body"><%= sync_started_at(latest) %></dd>
          <dt class="text-text-muted"><%= t("sync_runs.columns.duration") %></dt>
          <dd class="text-text-body"><%= sync_duration(latest.duration_seconds) %></dd>
        </dl>
      <% else %>
        <p class="text-sm text-text-body"><%= t("sync_runs.history.empty") %></p>
      <% end %>
    <% end %>
  <% end %>

  <%= ui :card, data: { sync_inventory: true } do %>
    <%= ui :card_header do %>
      <%= ui :card_title, t("sync_runs.inventory.title"), level: 2 %>
    <% end %>
    <%= ui :card_content do %>
      <dl class="grid grid-cols-[max-content_1fr] gap-x-8 gap-y-2 text-sm">
        <% inventory.each do |key, count| %>
          <dt class="text-text-muted"><%= t("sync_runs.inventory.#{key}") %></dt>
          <dd class="text-text-body tabular-nums"><%= number_with_delimiter(count) %></dd>
        <% end %>
      </dl>
    <% end %>
  <% end %>
</div>
