<%# locals: (sync_run:) %>
<dl class="grid grid-cols-[max-content_1fr] gap-x-8 gap-y-2 text-sm">
  <dt class="text-text-muted"><%= t("sync_runs.columns.started") %></dt>
  <dd class="text-text-body"><%= sync_started_at(sync_run) %></dd>
  <dt class="text-text-muted"><%= t("sync_runs.columns.duration") %></dt>
  <dd class="text-text-body tabular-nums"><%= sync_duration(sync_run) %></dd>
</dl>

<h2 class="mt-8 text-lg font-semibold text-text-heading"><%= t("sync_runs.detail.phases_heading") %></h2>
<% phases = sync_run.phases_in_order %>
<% if phases.any? %>
  <ul role="list" class="mt-4 grid gap-4 md:grid-cols-2">
    <% phases.each do |phase| %>
      <li data-sync-phase>
        <%= ui :card, class: "h-full" do %>
          <%= ui :card_header do %>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <%= ui :card_title, t("sync_runs.phases.#{phase.key}"), level: 3 %>
              <%= sync_phase_status_badge(phase) %>
            </div>
          <% end %>
          <%= ui :card_content do %>
            <dl class="grid grid-cols-[max-content_1fr] gap-x-8 gap-y-1 text-sm">
              <% if phase.duration_seconds || phase.running? %>
                <dt class="text-text-muted"><%= t("sync_runs.columns.duration") %></dt>
                <dd class="text-text-body tabular-nums"><%= sync_duration(phase) %></dd>
              <% end %>
              <% SyncRunsHelper::COUNTERS.each do |counter| %>
                <% next unless phase.counters.key?(counter) %>
                <dt class="text-text-muted"><%= t("sync_runs.counters.#{counter}") %></dt>
                <dd class="text-text-body tabular-nums"><%= number_with_delimiter(phase.counters[counter]) %></dd>
              <% end %>
            </dl>
            <% [ [ phase.error_messages, t("sync_runs.detail.error_messages", count: phase.error_messages.size), true ],
                 [ phase.warnings, t("sync_runs.detail.warnings", count: phase.warnings.size), false ] ].each do |messages, summary, open| %>
              <% next if messages.blank? %>
              <%= tag.details class: "mt-3 text-sm", open: open do %>
                <summary class="cursor-pointer font-medium text-text-heading focus-ring list-item w-full py-3 min-h-input">
                  <%= summary %>
                </summary>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-text-body">
                  <% messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state", message: t("sync_runs.detail.no_phases") %>
<% end %>
