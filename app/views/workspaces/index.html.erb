<% content_for(:title) { t("workspaces.index.title") } %>
<%# Phones lead with the switcher, so the column's top padding is the same
    pt-4 the layout gives it on a workspace page, not the desktop's py-16;
    px-6 matches the shell so the control shares the heading's left edge. %>
<div class="max-w-4xl mx-auto px-6 pt-4 pb-16 md:pt-16">
  <%# The switcher stays in place here too, on phones, in its "All workspaces"
      state — the index was the one authenticated page where that affordance
      vanished (#1090). No workspace is current, so the trigger names the user
      (it is the identity anchor below md) and the menu marks the All-workspaces
      row current. -mx-2 lets the button's own padding bleed outward so its
      avatar lands on the heading's edge. Unsuffixed would also be unique on
      this page (no sidebar copy), but the phone trigger is always -mobile so
      the responsive specs address one id. %>
  <div class="md:hidden -mx-2">
    <%= render "shared/workspace_switcher", workspace: nil, id_suffix: "-mobile", capped: true %>
  </div>
  <%# Identity anchor: this is the signed-in user's own home for workspaces
      (the former /me), so it opens with who "you" are before the list. Below
      md the switcher trigger carries the same avatar and name, so this row
      only renders where the trigger does not. %>
  <div class="hidden md:flex items-center gap-3 mb-6" data-test="workspaces-identity">
    <%= avatar_for(Current.user, size: :md) %>
    <span class="text-sm font-medium text-text-body truncate"><%= Current.user.full_name %></span>
  </div>
  <%# #769: header stacks at mobile so the action label never wraps inside
      its own button. %>
  <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-3xl font-bold text-text-heading">
      <%= t("workspaces.index.title") %>
    </h1>
    <% if TenancyConfig.workspace_creation_enabled? %>
      <%= link_to t("workspaces.index.new_workspace"), new_workspace_path,
            class: "btn-primary whitespace-nowrap" %>
    <% end %>
  </div>

  <% if @current_membership.present? %>
    <section class="mt-8" data-test="current-workspace-row" aria-label="<%= t('workspaces.index.current_badge') %>">
      <ul class="flex flex-col gap-2">
        <% if @current_membership.workspace.suspended? %>
          <%= render "workspaces/locked_row", workspace: @current_membership.workspace %>
        <% else %>
          <%= render "workspaces/row", membership: @current_membership, current: true %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @other_memberships.any? %>
    <%# Client-side name filter appears once the list is long enough to scan —
        a user's own workspaces, rendered in full (no server round-trip). See
        workspace_filter_controller.js. Threshold kept modest so it helps well
        before the list becomes unwieldy. %>
    <% show_filter = @other_memberships.size >= 3 %>
    <% section_attrs = show_filter ? { data: { controller: "workspace-filter",
         workspace_filter_status_template_value: t("workspaces.index.filter.status") } } : {} %>
    <%= tag.section class: "mt-8", **section_attrs do %>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">
        <%= t("workspaces.index.other_workspaces_heading") %>
      </h2>
      <% if show_filter %>
        <div class="mb-3">
          <label for="workspace-filter" class="sr-only"><%= t("workspaces.index.filter.label") %></label>
          <input type="search" id="workspace-filter" autocomplete="off"
                 placeholder="<%= t("workspaces.index.filter.placeholder") %>"
                 data-workspace-filter-target="input"
                 data-action="input->workspace-filter#filter"
                 class="form-input w-full">
          <p class="sr-only" role="status" aria-live="polite" data-workspace-filter-target="status"></p>
        </div>
      <% end %>
      <ul class="flex flex-col gap-2" data-test="other-workspaces-list">
        <% @other_memberships.each do |membership| %>
          <% if membership.workspace.suspended? %>
            <%= render "workspaces/locked_row", workspace: membership.workspace %>
          <% else %>
            <%= render "workspaces/row", membership: membership, current: false %>
          <% end %>
        <% end %>
      </ul>
      <% if show_filter %>
        <p class="mt-4 text-sm text-text-muted" data-workspace-filter-target="empty" hidden>
          <%= t("workspaces.index.filter.empty") %>
        </p>
      <% end %>
    <% end %>
  <% end %>

  <% if @archived_memberships.any? %>
    <section class="mt-8" data-test="archived-workspaces">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">
        <%= t("workspaces.index.archived_heading") %>
      </h2>
      <%# UI::ListGroup (#735): one divided container; locked_row renders as a
          plain li inside it (the group owns border and dividers). %>
      <%= ui :list_group do %>
        <% @archived_memberships.each do |membership| %>
          <% if membership.workspace.suspended? %>
            <%= render "workspaces/locked_row", workspace: membership.workspace %>
          <% else %>
            <%# hover:bg-surface: the row is not the control, the Restore button
                is, so it must not highlight like one — and the gem's row hover
                puts the button's text-interactive at 6.85:1, below AAA
                (modelrails_ui#197). %>
            <%= ui :list_group_item, class: "gap-4 hover:bg-surface" do %>
              <div class="min-w-0">
                <p class="font-medium text-text-heading truncate"><%= membership.workspace.name %></p>
                <p class="text-sm text-text-muted"><%= lifecycle_status_label(membership.workspace) %></p>
              </div>
              <%= button_to t("lifecycle.restore"), workspace_archival_path(membership.workspace),
                    method: :delete,
                    class: "btn-touch-target btn-text btn-text-interactive text-sm shrink-0" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @memberships.empty? && @archived_memberships.empty? %>
    <div class="mt-8">
      <%= render "shared/empty_state",
            message: t("workspaces.index.empty"),
            action_text: TenancyConfig.workspace_creation_enabled? ? t("workspaces.index.new_workspace") : nil,
            action_url: TenancyConfig.workspace_creation_enabled? ? new_workspace_path : nil %>
    </div>
  <% end %>

  <% if TenancyConfig.workspace_creation_enabled? %>
    <div class="mt-12 text-center">
      <%= link_to t("workspaces.index.create_workspace_cta"), new_workspace_path,
            class: "btn-touch-target inline-flex items-center px-4 py-2 rounded-md
                    text-sm font-medium text-interactive
                    hover:bg-surface-sunken
                    focus-ring" %>
    </div>
  <% end %>
</div>
