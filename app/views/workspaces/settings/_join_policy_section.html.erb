<%# Join Policy — per-workspace control over how new members join. Hidden
    under :shared posture (no separate join story in single-tenant). %>
<% open_link_permitted = SignupPolicy.permits_strategy?(:open_link) %>
<% current_link = workspace.join_links.current.order(created_at: :desc).first %>

<section class="rounded-lg border border-border bg-surface-raised p-6">
  <h2 id="join-policy-heading" class="text-lg font-semibold text-text-heading">
    <%= t("workspaces.settings.join_policy.heading") %>
  </h2>
  <p class="mt-1 text-sm text-text-muted">
    <%= t("workspaces.settings.join_policy.description") %>
  </p>

  <%# The unavailable-strategy explanation joins the option's DESCRIPTION rather
      than sitting in its label. Inside the label it became part of the radio's
      accessible name, so a reader announced the whole paragraph as the option
      itself; as a description it is read after the name, which is what a
      supporting line is for (#738, modelrails_ui #137).

      Unavailability leads when it applies: for an option the reader cannot
      choose, "why is this greyed out" is the fact they came for, and trailing
      it behind the feature description buries it mid-paragraph. -%>
  <% open_link_description = [
       (t("workspaces.settings.join_policy.open_link_disabled_explanation") unless open_link_permitted),
       t("workspaces.settings.join_policy.open_link_help")
     ].compact.join(" ") %>

  <%= form_with model: workspace, url: workspace_settings_path(workspace), method: :patch, local: true, class: "mt-4 space-y-3" do |f| %>
    <%# Named by the card's own heading: these two radios ARE the card's subject,
        so a second label would only repeat it. -%>
    <%# gap-3 over the component's default gap-2: that default is tuned for
        label-only options, and every option here carries a description that
        wraps to two or three lines, so 8px lets the two run together. -%>
    <%= ui :radio_group,
          name: "workspace[join_policy]",
          labelledby: "join-policy-heading",
          class: "gap-3",
          items: [
            { value: "invite",
              label: t("workspaces.settings.join_policy.invite_label"),
              description: t("workspaces.settings.join_policy.invite_help"),
              checked: workspace.invite? },
            { value: "open_link",
              label: t("workspaces.settings.join_policy.open_link_label"),
              description: open_link_description,
              checked: workspace.open_link?,
              disabled: !open_link_permitted }
          ] %>

    <div class="pt-2">
      <%= f.submit t("workspaces.settings.join_policy.save"),
            class: "btn-primary" %>
    </div>
  <% end %>

  <% if workspace.open_link? && open_link_permitted %>
    <div class="mt-6 pt-6 border-t border-border">
      <h3 class="text-sm font-semibold text-text-heading">
        <%= t("workspaces.settings.join_policy.active_link_heading") %>
      </h3>

      <% if flash[:join_link_url].present? %>
        <%# Show-once reveal: the full URL is shown exactly once, right after
            generate/rotate. The token is hashed at rest, so it can never be
            re-displayed — copy it now or rotate for a new one. data-turbo-temporary
            keeps the reveal out of Turbo's snapshot, so Back does not re-show it. %>
        <div data-turbo-temporary>
          <p id="join_link_show_once_warning" class="mt-2 rounded-md border border-warning-border bg-warning-surface px-3 py-2 text-sm text-warning">
            <span class="font-semibold"><%= t("workspaces.settings.join_policy.show_once_warning_lead") %></span>
            <%= t("workspaces.settings.join_policy.show_once_warning") %>
          </p>
          <%= ui :copy,
                value: flash[:join_link_url],
                label: t("workspaces.settings.join_policy.link_aria"),
                label_hidden: true,
                describedby: "join_link_show_once_warning",
                # Inert on this page today: this redirect targets the same URL under
                # Turbo morph, which skips Turbo's autofocus-on-render (#1036).
                autofocus: true,
                class: "mt-2" %>

          <%# Freshly minted/rotated, so never expired yet — no colour, just the
              date in words, matching the steady-state expiry line below (#952). %>
          <p class="mt-1 text-xs text-text-muted">
            <time datetime="<%= current_link.expires_at.iso8601 %>">
              <%= t("workspaces.settings.join_policy.expires_on", date: l(current_link.expires_at, format: :long)) %>
            </time>
          </p>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <%= button_to t("workspaces.settings.join_policy.revoke"),
                workspace_join_link_path(workspace, current_link),
                method: :delete,
                form: { data: { turbo_confirm: t("workspaces.settings.join_policy.revoke_confirm") } },
                class: "btn-outline-danger text-sm" %>
        </div>

      <% elsif current_link %>
        <%# Steady state: no live URL. The plaintext is gone; show a non-secret
            stub and offer rotate (which reveals a fresh link once). %>
        <div class="mt-2 font-mono text-sm text-text-muted" aria-describedby="join_link_expiry">
          <span class="sr-only"><%= t("workspaces.settings.join_policy.masked_aria") %></span>
          <span aria-hidden="true"><%= current_link.masked_token %></span>
        </div>
        <p class="mt-1 text-xs text-text-muted">
          <%= t("workspaces.settings.join_policy.masked_help") %>
        </p>

        <%# Expiry conveyed in words, never by colour alone (#952). The
            paragraph's id is the aria-describedby target for both the rotate
            button and the masked stub above. %>
        <p id="join_link_expiry" class="mt-1 text-xs text-text-muted">
          <% if current_link.expired? %>
            <%= t("workspaces.settings.join_policy.expired") %>
          <% else %>
            <time datetime="<%= current_link.expires_at.iso8601 %>">
              <%= t("workspaces.settings.join_policy.expires_on", date: l(current_link.expires_at, format: :long)) %>
            </time>
          <% end %>
          <%= t("workspaces.settings.join_policy.rotate_help") %>
        </p>

        <div class="mt-4 flex items-center gap-3">
          <%= button_to t("workspaces.settings.join_policy.rotate"),
                workspace_join_links_path(workspace),
                method: :post,
                aria: { describedby: "join_link_expiry" },
                form: { data: { turbo_confirm: t("workspaces.settings.join_policy.rotate_confirm") } },
                class: "btn-touch-target inline-flex items-center px-3 py-2 rounded-md text-sm
                        border border-border hover:bg-surface-sunken
                        focus-ring" %>

          <%= button_to t("workspaces.settings.join_policy.revoke"),
                workspace_join_link_path(workspace, current_link),
                method: :delete,
                form: { data: { turbo_confirm: t("workspaces.settings.join_policy.revoke_confirm") } },
                class: "btn-outline-danger text-sm" %>
        </div>

      <% else %>
        <p class="mt-2 text-sm text-text-muted">
          <%= t("workspaces.settings.join_policy.no_active_link") %>
        </p>
        <div class="mt-3">
          <%= button_to t("workspaces.settings.join_policy.generate"),
                workspace_join_links_path(workspace),
                method: :post,
                class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
