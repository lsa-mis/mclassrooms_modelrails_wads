<h1><%= t("invitation_mailer.invite.greeting") %></h1>

<p><%= t("invitation_mailer.invite.body", inviter: @inviter.email_address, app_name: t("application.name"), role: @role.name) %></p>

<p><%= link_to t("invitation_mailer.invite.accept_action"), @accept_url %></p>

<p><%= link_to t("invitation_mailer.invite.decline_action"), @decline_url %></p>
<p><%= link_to t("invitation_mailer.invite.block_action"), @block_url %></p>

<p><%= t("invitation_mailer.invite.expiry_note") %></p>
