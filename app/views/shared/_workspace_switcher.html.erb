<%# locals: (workspace:, id_suffix: "", capped: false) -%>
<%# The workspace switcher as the sidebar's head, carrying identity (logo +
    name + role) and the switch affordance in ONE control. Being one control is
    what lets it clear mc-target-size-44 as a block; the identity bar this
    replaced needed a separate 44px name link, whose 22px of dead space could
    not fit beside a 40px logo.

    Unlike the old header switcher this ALWAYS renders: below 2 workspaces it
    is still the only place the workspace is named, so it degrades to identity
    plus "All workspaces" rather than disappearing.

    The trigger lives in its own partial because the rename broadcast replaces
    it whole (see _workspace_switcher_trigger). -%>
<% workspaces = switcher_workspaces %>

<div data-controller="menu" data-action="click@document->menu#closeOnClickOutside"
     class="relative mb-6">
  <%= render "shared/workspace_switcher_trigger", workspace: workspace, id_suffix: id_suffix %>

  <div data-menu-target="menu" data-action="keydown->menu#navigate"
       id="workspace-switcher-menu<%= id_suffix %>" role="menu" tabindex="-1" hidden
       aria-labelledby="workspace-switcher-button<%= id_suffix %>"
       class="absolute left-0 right-0 mt-1 rounded-lg bg-surface-raised border border-border shadow-lg z-50 py-1">
    <% if workspaces.size > 1 %>
      <%# capped: the phone copy pins the current workspace first and shows at
          most five (the hamburger's old bound), so a long list cannot run the
          dropdown off a 375px screen; "All workspaces" below is the overflow.
          Recency sort only inside this 2+ branch — it materializes the relation. %>
      <% shown = capped ? ([ workspace ].compact + workspaces_by_recency(workspaces).reject { |w| workspace && w.id == workspace.id }).first(5) : workspaces %>
      <% shown.each do |candidate| %>
        <% is_current = workspace && candidate.id == workspace.id %>
        <% membership = candidate.memberships.detect { |m| m.user_id == Current.user.id } %>
        <%= link_to main_app.workspace_path(candidate), role: "menuitem", tabindex: "-1",
              data: { menu_target: "item", action: "click->menu#activate" },
              aria: { current: ("true" if is_current) },
              class: [ "min-h-[44px] flex items-center gap-3 py-2 text-sm",
                      (is_current ? "pl-2 pr-3 border-l-4 border-interactive bg-surface-sunken font-semibold text-text-heading"
                                  : "px-3 text-text-body hover:bg-surface-sunken") ].compact do %>
          <span class="shrink-0">
            <%= workspace_icon_for(candidate, size: :sm) %>
          </span>
          <span class="flex-1 min-w-0">
            <span class="block truncate"><%= candidate.name %></span>
            <span class="block text-xs text-text-muted"><%= membership&.role&.name %></span>
          </span>
        <% end %>
      <% end %>
    <% end %>
    <%# On the workspaces index no workspace is current, so this row is —
        marked and styled the same way a current workspace row is (#1090). The
        empty span holds the icon slot so the label lines up with the names. %>
    <%= link_to main_app.workspaces_path,
          role: "menuitem", tabindex: "-1",
          aria: { current: ("true" if workspace.nil?) },
          data: { menu_target: "item", action: "click->menu#activate", turbo_prefetch: "true" },
          class: [ "min-h-[44px] flex items-center gap-3 py-2 text-sm",
                   (workspace.nil? ? "pl-2 pr-3 border-l-4 border-interactive bg-surface-sunken font-semibold text-text-heading"
                                   : "px-3 text-interactive hover:bg-surface-sunken") ] do %>
      <span class="shrink-0 w-8 h-8" aria-hidden="true"></span>
      <span class="block truncate"><%= t("navigation.all_workspaces") %></span>
    <% end %>
  </div>
</div>
