<%# locals: (model:, form_url:, hub_url:, hub_title:, crop_title:) -%>
<%
  identity = model.identity
  has_image = identity.image?
  original_url = url_for(identity.croppable_image) if has_image
%>

<div data-controller="identity-picker"
     data-identity-picker-form-url-value="<%= form_url %>"
     data-identity-picker-has-image-value="<%= has_image %>"
     data-identity-picker-hub-title-value="<%= hub_title %>"
     data-identity-picker-crop-title-value="<%= crop_title %>"
     data-identity-picker-invalid-type-message-value="<%= t('identity_picker.js.invalid_type') %>"
     data-identity-picker-file-too-large-message-value="<%= t('identity_picker.js.file_too_large') %>"
     data-identity-picker-upload-failed-message-value="<%= t('identity_picker.js.upload_failed') %>"
     data-identity-picker-upload-failed-network-message-value="<%= t('identity_picker.js.upload_failed_network') %>"
     data-identity-picker-color-announce-template-value="<%= t('identity_picker.js.color_announce') %>"
     data-identity-picker-color-names-value="<%= t('identity_picker.js.color_names') %>"
     data-identity-picker-original-url-value="<%= original_url %>">

  <%# Hidden file input — triggered programmatically %>
  <input type="file"
         accept="image/png,image/jpeg,image/gif,image/webp"
         class="sr-only"
         data-identity-picker-target="fileInput"
         data-action="change->identity-picker#handleFileSelected"
         aria-label="<%= t('identity_picker.select_file') %>">

  <%# ARIA live region for announcements %>
  <div aria-live="polite" class="sr-only"></div>

  <%# Hub view — lazy-loaded via Turbo Frame %>
  <turbo-frame id="identity-picker-hub" src="<%= hub_url %>" loading="lazy">
  </turbo-frame>

  <div data-identity-picker-target="cropSection" hidden>
    <div class="flex items-center justify-between mb-4">
      <button type="button"
              data-action="click->identity-picker#backToHub"
              class="inline-flex items-center gap-1.5 text-sm text-interactive
                     hover:text-interactive-hover
                     min-h-[var(--form-input-height)] px-2 rounded
                     focus-ring">
        <%= icon(:arrow_left, size: :sm) %>
        <%= t("identity_picker.back_to_source") %>
      </button>
      <h3 class="text-lg font-semibold text-text-heading">
        <%= t("identity_picker.crop_title") %>
      </h3>
    </div>

    <%# image-cropper controller scoped to the grid so targets in both columns are reachable %>
    <%# Keyboard: tabindex/keydown are on the cropper-container only, so arrow keys
        don't conflict with the zoom slider or buttons elsewhere in the grid %>
    <div class="grid gap-6 sm:grid-cols-[1fr_300px]"
         data-controller="image-cropper"
         data-image-cropper-aspect-ratio-value="1"
         data-image-cropper-ready-announce-value="<%= t('identity_picker.js.cropper_ready') %>"
         data-image-cropper-reset-announce-value="<%= t('identity_picker.js.cropper_reset') %>"
         data-image-cropper-zoom-announce-value="<%= t('identity_picker.js.zoom_announce') %>"
         data-action="image-cropper:cropChanged->identity-picker#updateCropPreview">
      <%= render "shared/identity_picker/crop_viewport",
            has_image: has_image, original_url: original_url %>
      <%= render "shared/identity_picker/crop_controls" %>
      <%= render "shared/identity_picker/crop_footer", form_url: form_url %>
    </div>
  </div>
</div>
