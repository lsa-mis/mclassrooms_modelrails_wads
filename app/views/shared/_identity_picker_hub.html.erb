<%# locals: (identity:, model:, form_url:, hub_url:, current_source:) -%>
<%
  display_url = identity.image? ? url_for(identity.image) : nil
  gravatar_url = identity.gravatar_url
  file_input_id = "#{dom_id(model)}-identity-picker-file-hub"
%>
<turbo-frame id="identity-picker-hub">

  <%# Large preview — only ONE preview renders based on current_source %>
  <div class="flex flex-col items-center py-6">
    <% if current_source == "upload" && identity.image? %>
      <%# Photo preview (clickable to crop) %>
      <button type="button"
              data-action="click->identity-picker#openCrop"
              data-identity-picker-target="photoPreview"
              aria-label="<%= t('identity_picker.edit_photo') %>"
              class="relative w-32 h-32 rounded-full overflow-hidden
                     group cursor-pointer
                     focus-ring">
        <% if display_url %>
          <%= image_tag display_url,
                class: "w-full h-full object-cover",
                alt: "" %>
        <% else %>
          <div class="w-full h-full bg-surface-sunken flex items-center justify-center"
               aria-hidden="true">
            <%= icon(:camera, size: :lg, class: "text-text-muted") %>
          </div>
        <% end %>
        <span class="absolute inset-0 bg-black/0 group-hover:bg-black/30
                     flex items-center justify-center transition-colors">
          <%= icon(:pencil, size: :md,
                class: "text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-md") %>
        </span>
      </button>
    <% elsif current_source == "gravatar" && gravatar_url %>
      <%# Gravatar preview %>
      <%= image_tag gravatar_url,
            class: "w-32 h-32 rounded-full object-cover",
            alt: "",
            loading: "lazy" %>
    <% else %>
      <%# Initials preview (also fallback for upload with no image) %>
      <div class="w-32 h-32 rounded-full flex items-center justify-center text-3xl font-semibold text-text-on-hue-initials bg-hue-initials"
           data-identity-picker-target="initialsPreview hueSwatch"
           style="--hue: <%= identity.hue %>">
        <%= identity.initials %>
      </div>
    <% end %>

    <span class="text-xs text-text-muted mt-2 uppercase tracking-wider">
      <%= t("identity_picker.preview") %>
    </span>
    <% if identity.image_updated_at %>
      <span class="text-xs text-text-muted mt-1">
        <%= t("identity_picker.last_updated", time: time_ago_in_words(identity.image_updated_at)) %>
      </span>
    <% end %>
  </div>

  <% if current_source == "upload" %>
    <%# Input is the label's next sibling so Tab order matches visual order
        (2.4.3, #912). Also the manual fallback for the auto-file-picker
        below, which opens the OS dialog automatically with no photo yet. %>
    <div class="flex justify-center mb-2">
      <label for="<%= file_input_id %>"
             class="btn-text-icon btn-text-interactive text-sm px-2 inline-flex items-center min-h-11 cursor-pointer">
        <%= icon(:arrow_up_tray, size: :sm) %>
        <%= t("identity_picker.upload_new") %>
      </label>
      <input type="file"
             id="<%= file_input_id %>"
             accept="image/png,image/jpeg,image/gif,image/webp"
             class="sr-only"
             data-identity-picker-target="fileInput"
             data-action="change->identity-picker#handleFileSelected click->identity-picker#markFilePickerOpen">
    </div>
  <% end %>

  <%# Source selection %>
  <p class="text-sm text-text-muted mb-3"><%= t("identity_picker.choose_source") %></p>

  <%# Source cards — links that reload the turbo frame with a new source %>
  <div role="radiogroup" aria-label="<%= t('identity_picker.source_label') %>"
       class="space-y-2 mb-4">

    <% if identity.available_sources.include?("upload") %>
      <%= render "shared/identity_picker/source_card",
            source: "upload",
            hub_url: hub_url,
            current_source: current_source,
            visual: icon(:camera, size: :lg, class: "text-text-muted shrink-0") %>
    <% end %>

    <% if identity.available_sources.include?("gravatar") %>
      <%= render "shared/identity_picker/source_card",
            source: "gravatar",
            hub_url: hub_url,
            current_source: current_source,
            visual: icon(:globe_alt, size: :lg, class: "text-text-muted shrink-0") %>
    <% end %>

    <% if identity.available_sources.include?("initials") %>
      <% initials_visual = capture do %>
        <span class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-semibold text-text-on-hue-initials shrink-0 bg-hue-initials"
              data-identity-picker-target="hueSwatch"
              style="--hue: <%= identity.hue %>">
          <%= identity.initials %>
        </span>
      <% end %>
      <%= render "shared/identity_picker/source_card",
            source: "initials",
            hub_url: hub_url,
            current_source: current_source,
            visual: initials_visual %>
    <% end %>
  </div>

  <%# Color picker panel — only renders when initials selected and color picker enabled %>
  <% if current_source == "initials" %>
    <div class="p-4 rounded-lg border border-border space-y-3 mb-4">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-text-heading">
          <%= t("identity_picker.color_label") %>
        </span>
        <span class="text-xs font-mono text-text-muted"
              data-identity-picker-target="colorHex">
          <%= t("identity_picker.initial_color_name") %>
        </span>
      </div>
      <%# UI::Range (#733): component thumb/track chrome (cross-browser, ≥24px
          thumb). The hue gradient rides `.hue-range` (application.css), which
          targets the track pseudo-elements — an inline background on the input
          cannot reach them and painted UNDER the component's sunken track bar. %>
      <%# The slider rides hueSwatch too: its --hue feeds the loupe thumb
          (.hue-range::-*-thumb reads it), so the thumb previews the pending
          color exactly as the discs do. %>
      <%= render UI::RangeComponent.new(
            min: 0, max: 360, step: 1, value: identity.hue,
            class: "hue-range w-full min-h-11",
            autocomplete: "off",
            "aria-label": t("identity_picker.color_aria_label"),
            style: "--hue: #{identity.hue}",
            data: {
              "identity-picker-target": "colorSlider hueSwatch",
              action: "input->identity-picker#handleColorChange"
            }
          ) %>
    </div>
  <% end %>

  <%# Save form — breaks out of the turbo frame to apply the change %>
  <%= form_with url: form_url, method: :patch,
        data: { turbo_frame: "_top" },
        class: "space-y-2" do |f| %>
    <input type="hidden" name="avatar_source" value="<%= current_source %>">
    <input type="hidden" name="primary_color" value="<%= identity.hue %>"
           data-identity-picker-target="colorField">

    <div class="pt-2">
      <%= f.submit t("identity_picker.save"),
            class: "btn-primary w-full flex items-center justify-center gap-2" %>
    </div>
  <% end %>

  <%# Auto-file-picker trigger — renders when Photo selected with no existing image %>
  <% if current_source == "upload" && !identity.image? %>
    <div data-controller="auto-file-picker"
         data-auto-file-picker-target-value="[data-identity-picker-target='fileInput']">
    </div>
  <% end %>

</turbo-frame>
