<%# locals: (message:, action_text: nil, action_url: nil) -%>
<%= ui :empty_state, title: message do |c| %>
  <% c.with_icon { icon(:information_circle) } %>
  <% if action_text && action_url %>
    <% c.with_action do %>
      <%= link_to action_text, action_url,
            class: "inline-flex items-center px-4 py-2 min-h-input rounded-md text-sm font-medium
                    text-interactive hover:text-interactive-hover
                    focus-ring" %>
    <% end %>
  <% end %>
<% end %>
