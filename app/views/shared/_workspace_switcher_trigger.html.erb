<%# locals: (workspace:, id_suffix: "") -%>
<%# id_suffix: phones render this a second time in the content column while
    the sidebar copy is display:none — present in the DOM, not absent — so the
    second copy suffixes every id here and on its menu (#1077). -%>
<%# The switcher's trigger: workspace identity (logo + name + role) and the
    switch affordance as ONE control. Shared with workspaces/update.turbo_stream
    so the live trigger and the rename broadcast cannot drift — the broadcast
    replaces this whole button rather than patching pieces of it.

    The name is a <span>, never a link. It used to be one (shared/_workspace_
    name_link, for the identity bar this replaced); an anchor inside this button
    is a nested-interactive axe failure, which is what the personal-workspace
    rename spec caught when the id moved in here. -%>
<button data-menu-target="trigger" data-action="click->menu#toggle keydown->menu#triggerKeydown"
        id="workspace-switcher-button<%= id_suffix %>" type="button"
        aria-haspopup="menu" aria-expanded="false" aria-controls="workspace-switcher-menu<%= id_suffix %>"
        class="w-full min-h-[44px] flex items-center gap-3 px-2 py-2 rounded-lg text-left
               hover:bg-surface-sunken aria-expanded:bg-surface-sunken aria-expanded:text-text-heading focus-ring">
  <%# No workspace (the workspaces index, #1090): the trigger is the page's
      identity anchor on phones — the user's own avatar and name where a
      workspace's icon and name go, "All workspaces" where the role goes — so
      the index keeps the two-line shape the trigger has on every workspace
      page. The wrapper only stops the icon shrinking: the avatar component
      sets its own size and rounding, and the helpers take no class. %>
  <span class="shrink-0">
    <%= workspace ? workspace_icon_for(workspace, size: :md) : avatar_for(Current.user, size: :md) %>
  </span>
  <span class="flex-1 min-w-0">
    <span id="workspace-name-heading<%= id_suffix %>" class="block truncate text-sm font-bold text-text-heading">
      <%= workspace ? workspace.name : Current.user.full_name %>
    </span>
    <% secondary = workspace ? current_user_role_in(workspace)&.name : t("navigation.all_workspaces") %>
    <% if secondary %>
      <span id="workspace-identity-role<%= id_suffix %>" class="block truncate text-xs text-text-muted">
        <%= secondary %>
      </span>
    <% end %>
  </span>
  <span aria-hidden="true" class="shrink-0 text-text-muted">&#9662;</span> <%# erblint:disable HardCodedString - presentational glyph, not language (#498) %>
</button>
