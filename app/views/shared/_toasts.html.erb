<%
  toast_types = Rails.application.config.toasts[:types]
%>
<%# Top-center: success/info pills %>
<%# role="region" (a named landmark) is load-bearing twice over: aria-label is
    prohibited on a role-less (generic) div, and these fixed containers sit
    outside <main>/<header>/<footer>, so any non-landmark role would leave
    their content outside every landmark (axe: aria-prohibited-attr + region —
    role="group" clears only the first).
    aria-live lives HERE, on the stable containers (#683): a live region must
    be registered BEFORE content arrives, and appended toasts that carry their
    own aria-live are inserted-with-content — AT silently drops them. Page-load
    flashes are moved in after load for the same reason (#901, below). %>
<div id="toast-pills"
     role="region"
     aria-live="polite"
     aria-label="<%= t('toasts.pill_aria_label') %>"
     class="fixed top-[var(--toast-pill-top)] left-1/2 -translate-x-1/2 z-[var(--toast-z)]
            flex flex-col items-center gap-2
            pointer-events-none">
</div>

<%# Bottom-center: warning/error cards %>
<div id="toast-cards"
     role="region"
     aria-live="assertive"
     aria-label="<%= t('toasts.card_aria_label') %>"
     class="fixed bottom-[var(--toast-card-bottom)] left-1/2 -translate-x-1/2 z-[var(--toast-z)]
            flex flex-col items-center gap-3 pb-[env(safe-area-inset-bottom)]
            max-w-[calc(100vw-2rem)]
            pointer-events-none">
</div>

<%# Page-load flashes travel OUTSIDE the live regions and are moved in after
    load by toast_flash_controller (#901): a region announces changes made
    after it is registered, so a toast rendered inside it at parse time is
    never spoken. data-turbo-temporary keeps the carrier out of Turbo's
    snapshot, so Back never replays a flash. %>
<% { pill: "toast-pills", card: "toast-cards" }.each do |tier, container_id| %>
  <% tier_flashes = flash.select { |type, _| toast_types.dig(type.to_sym, :tier) == tier } %>
  <% next if tier_flashes.empty? %>
  <template data-controller="toast-flash"
            data-toast-flash-container-value="<%= container_id %>"
            data-turbo-temporary>
    <% tier_flashes.each do |type, message| %>
      <%= render "shared/toast_#{tier}", type: type, message: message %>
    <% end %>
  </template>
<% end %>
