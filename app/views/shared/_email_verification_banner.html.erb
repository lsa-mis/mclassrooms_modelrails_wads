<%# UI::Banner (#731): a labelled region present on load — deliberately NOT a
    live region (the old role=status re-announced on every Turbo render).
    Layout (centered max-w inner strip) rides the content block. %>
<% if Current.user&.email_verification_pending? %>
  <%= render UI::BannerComponent.new(
        variant: :warning,
        label: t("email_verifications.banner.label"),
        id: "verify-banner",
        class: "rounded-none border-x-0 border-t-0 border-b"
      ) do %>
    <div class="max-w-5xl mx-auto px-4 py-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <%= icon(:envelope, size: :sm, class: "shrink-0") %>
      <span><%= t("email_verifications.banner.message") %></span>
      <%= link_to t("email_verifications.banner.action"), new_email_verification_path,
            class: "font-semibold underline hover:no-underline focus-ring rounded" %>
    </div>
  <% end %>
<% end %>
