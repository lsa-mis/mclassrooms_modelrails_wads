<%# OAuth buttons are text-only ("Sign in with Google/GitHub") — a deliberate
    template-minimalism ruling (#773 item 4): provider brand marks mean per-provider
    SVG assets and brand-guideline upkeep the fork-first template shouldn't carry.
    Forks that want the marks add them per their own brand review. %>
<% if oauth_enabled? %>
  <%# mt-8 matches the page stack's section gap (#773 item 1) so the heading
      reads as the card's title, not a label on the first provider button. %>
  <div class="mt-8 space-y-3">
    <% enabled_oauth_providers.each do |provider_key, config| %>
      <%= button_to "/auth/#{provider_key}",
            method: :post,
            form: { data: { turbo: false } },
            class: "btn-secondary w-full gap-3" do %>
        <span class="font-medium"><%= t("oauth.sign_in_with", provider: config[:name]) %></span>
      <% end %>
    <% end %>
  </div>

  <div class="relative my-6">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-border"></div>
    </div>
    <div class="relative flex justify-center text-sm">
      <span class="px-4 bg-surface-raised text-text-muted">
        <%= t("oauth.or") %>
      </span>
    </div>
  </div>
<% end %>
