<%# locals: (name:, label:, checked: false, disabled: false, value: "true", help: nil, hidden_value: nil, visible_label: true) -%>
<%# App-side seam over UI::SwitchComponent (#736): call sites keep this
    partial's locals contract; the switch chrome, 44px label target and
    role="switch" semantics come from the gem component. Two behaviors are
    deliberately COMPOSED here rather than component options (the gem has
    neither; composition is the sanctioned shape):
    - `help` renders as a SIBLING span referenced by aria-describedby — never
      inside a label — so it describes the control without doubling into its
      accessible name (#745);
    - a disabled row stays DISCOVERABLE: aria-disabled + the auto-submit
      controller's click guard instead of native `disabled` (which removes
      the row from the tab order entirely), with the hidden field still
      asserting the always-on value server-side (#745).
    `visible_label: false` swaps the text label for aria-label, so the name
    equals the row title exactly (2.5.3 label-in-name) — pass it whenever the
    toggle is the `control:` of shared/_preferences_row. %>
<%
  hint_id = "toggle-#{name.to_s.parameterize.tr('_', '-')}-#{SecureRandom.hex(2)}-hint" if help.present?
  input_attrs = { name: name, value: value }
  input_attrs["aria-label"] = label unless visible_label
  if disabled
    input_attrs["aria-disabled"] = "true"
    input_attrs[:data] = { action: "click->auto-submit#guardDisabled change->auto-submit#submit" }
  else
    input_attrs[:data] = { action: "change->auto-submit#submit" }
  end
%>
<div class="inline-flex flex-col">
  <%= render UI::SwitchComponent.new(
        label: (label if visible_label),
        checked: checked,
        describedby: hint_id,
        class: ("opacity-50" if disabled),
        **input_attrs
      ) %>
  <% if hidden_value && disabled %>
    <input type="hidden" name="<%= name %>" value="<%= hidden_value %>">
  <% end %>
  <% if help.present? %>
    <span id="<%= hint_id %>" class="text-xs text-text-muted"><%= help %></span>
  <% end %>
</div>
