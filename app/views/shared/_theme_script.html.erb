<%# The only inline script: sets `dark` before first paint and defines
    window.ModelRails.themeIsDark for theme_controller (#624). -%>
<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    window.ModelRails = window.ModelRails || {};

    // One matchMedia list, shared with the controller, which also listens on it
    // for OS-level theme changes.
    window.ModelRails.darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

    // THE definition of "should this render dark". Both the pre-paint pass
    // below and theme_controller.js read it from here.
    window.ModelRails.themeIsDark = function(preference) {
      return preference === 'dark' ||
        (preference === 'system' && window.ModelRails.darkMediaQuery.matches);
    };

    var preference = document.documentElement.dataset.themeThemeValue || 'system';
    if (window.ModelRails.themeIsDark(preference)) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>
