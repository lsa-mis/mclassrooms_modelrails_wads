<%# locals: (form_url:) -%>
<div class="sm:col-span-full flex flex-col gap-3 pt-4 border-t border-border">
  <div class="flex items-center justify-end gap-3">
    <button type="button"
            data-action="click->identity-picker#backToHub"
            class="btn-secondary text-sm">
      <%= t("identity_picker.cancel") %>
    </button>
    <button type="button"
            data-action="click->identity-picker#saveCrop"
            class="btn-primary text-sm">
      <%= t("identity_picker.save_crop") %>
    </button>
  </div>
  <div class="flex items-center justify-between">
    <%# NOT .btn-text — deliberate (#760): its underline would run under the icon
        and replace the color-fade hover. Converts when an icon-aware text-button
        treatment ships. %>
    <button type="button"
            data-action="click->identity-picker#openFilePicker"
            class="inline-flex items-center gap-1.5 text-sm text-interactive
                   hover:text-interactive-hover
                   min-h-[var(--form-input-height)] px-2 rounded
                   focus-ring">
      <%= icon(:arrow_up_tray, size: :sm) %>
      <%= t("identity_picker.upload_new") %>
    </button>
    <%# NOT .btn-text — deliberate (#760): its underline would run under the icon
        and replace the color-fade hover. Converts when an icon-aware text-button
        treatment ships. %>
    <%= button_to form_url,
          method: :delete,
          class: "inline-flex items-center gap-1.5 text-sm text-danger
                  hover:text-danger/80
                  min-h-[var(--form-input-height)] px-2 rounded
                  focus-ring
                  bg-transparent border-0 cursor-pointer",
          data: { turbo_frame: "_top" } do %>
      <%= icon(:trash, size: :sm) %>
      <%= t("identity_picker.remove_photo") %>
    <% end %>
  </div>
</div>
