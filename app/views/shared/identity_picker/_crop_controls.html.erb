<%# locals: () -%>
<div class="space-y-5">
  <%= render "shared/identity_picker/crop_preview" %>

  <div>
    <div class="flex items-center justify-between mb-2">
      <span class="inline-flex items-center gap-1.5 text-sm font-medium text-text-heading">
        <%= t("identity_picker.zoom_label") %>
      </span>
      <span class="text-sm font-medium text-interactive"
            data-image-cropper-target="zoomPercent">
        100% <%# erblint:disable HardCodedString - presentational glyph, not language (#498) %>
      </span>
    </div>
    <%# UI::Range (#733): the component owns the cross-browser track/thumb
        chrome (including the ::-moz-range-thumb the hand-rolled version
        lacked); the image-cropper wiring and JS-maintained aria-valuenow
        ride **html_attrs. %>
    <%= render UI::RangeComponent.new(
          min: 0, max: 100, value: 0,
          class: "w-full",
          autocomplete: "off",
          "aria-label": t("identity_picker.zoom_aria_label"),
          "aria-valuemin": "0", "aria-valuemax": "100", "aria-valuenow": "0",
          data: {
            "image-cropper-target": "slider",
            action: "input->image-cropper#handleSlider"
          }
        ) %>
  </div>

  <button type="button"
          data-action="click->identity-picker#resetCrop"
          class="btn-secondary w-full gap-2 text-sm">
    <%= icon(:arrow_path, size: :sm) %>
    <%= t("identity_picker.reset_crop") %>
  </button>

  <%# GIF warning — shown only when source file is an animated GIF.
      DELIBERATELY NOT UI::Alert (#731): the chip is hidden-then-revealed by
      JS, and Alert bakes role=status + aria-live — un-hiding a populated
      live region announces unreliably (the form-draft notice documents the
      same lesson). Announcement, if ever wanted, belongs in a separate
      always-present sr-only status region. %>
  <div data-identity-picker-target="gifWarning"
       class="flex items-start gap-2.5 p-3 rounded-lg bg-warning-surface text-warning text-sm"
       hidden>
    <%= icon(:exclamation_triangle, size: :sm, class: "shrink-0 mt-0.5") %>
    <p><%= t("identity_picker.gif_static_warning") %></p>
  </div>

  <%# UI::Alert (#731): static on-load tip — role=status on load is inert. %>
  <%= render UI::AlertComponent.new(tone: :info, description: t("identity_picker.image_quality_tip")) %>
</div>
