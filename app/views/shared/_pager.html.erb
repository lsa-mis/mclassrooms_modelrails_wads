<%# locals: (pagy:, frame: nil) -%>
<%# The one pagy.series_nav call (#1169). `frame:` targets every link, built with
    tag.attributes so a frame name cannot escape the attribute. -%>
<% if pagy.pages > 1 %>
  <%== pagy.series_nav(
         aria_label: t("pagination.aria_label"),
         **(frame ? { anchor_string: tag.attributes(data: { turbo_frame: frame }) } : {})
       ) %>
<% end %>
