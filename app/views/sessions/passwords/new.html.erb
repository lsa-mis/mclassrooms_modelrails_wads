<%# A failed password sign-in re-renders here with 422 (SessionsController#create), a whole page. -%>
<%= render layout: "sessions/page" do %>
  <%= turbo_frame_tag "sign_in_form" do %>
    <p class="mt-4 text-sm text-text-muted"><%= t("sessions.passwords.new.password_prompt") %></p>
    <%= render "sessions/passwords/form", sign_in: @password_sign_in %>
  <% end %>
<% end %>
