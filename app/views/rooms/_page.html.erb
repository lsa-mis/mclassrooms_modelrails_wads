<%# locals: (room:, presenter:, editing:, form_room: room, saved_id: nil, open_media: nil) %>
<% gallery = room.gallery.includes(image_attachment: :blob).first(5) %>
<% has_pano = room.panorama.attached? %>
<% has_photos = gallery.any? %>
<% manage_media = editing && policy(room).manage_media? %>

<div class="group/room max-w-5xl mx-auto px-4 py-8" data-room-mode="<%= editing ? "edit" : "view" %>">
  <% if editing %>
    <%= form_with model: form_room, url: room_path(room), method: :patch, id: "room-edit-form" do %>
    <% end %>
  <% end %>

  <%= render "rooms/actions", room: room, presenter: presenter, saved_id: saved_id, editing: editing %>

  <% if editing %>
    <div data-testid="media-dock" class="mt-6 overflow-hidden rounded-lg border border-border">
      <%= render "rooms/edit/media_strip", room: room, presenter: presenter, form_room: form_room, manage_media: manage_media,
            open_media: open_media, photo_count: gallery.size %>
      <%= render "rooms/media", room: room, presenter: presenter, gallery: gallery,
            has_pano: has_pano, has_photos: has_photos, permanent: false, docked: true %>
    </div>

    <%= render "rooms/curated_fields", room: form_room %>
  <% else %>
    <%= render "rooms/media", room: room, presenter: presenter, gallery: gallery,
          has_pano: has_pano, has_photos: has_photos %>
  <% end %>

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0 space-y-8">
      <%= render "rooms/characteristics", presenter: presenter %>
      <%= render "notes/list", notable: room, editing: editing %>
    </div>

    <div class="space-y-4">
      <%= render "rooms/contacts", room: room %>
      <%= render "rooms/documents", room: room, form_room: form_room, manage_media: manage_media, open_media: open_media %>

      <% if room.building.full_address.present? %>
        <div data-testid="location-card" class="rounded-lg border border-border p-4">
          <h2 class="text-sm font-semibold text-text-heading"><%= t("rooms.show.address") %></h2>
          <p class="mt-2 text-sm text-text-body"><%= room.building.full_address %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
