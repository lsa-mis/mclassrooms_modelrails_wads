<%# locals: (room:, presenter:, form_room:, manage_media:, open_media:, photo_count:) %>
<div id="room_media_strip" data-testid="media-toolbar"
     class="flex flex-wrap items-center justify-between gap-3 border-b border-border bg-surface-raised px-4 py-3">
  <div class="flex min-w-0 items-center gap-3">
    <span class="shrink-0 text-interactive"><%= icon(:camera, size: :md) %></span>
    <div class="min-w-0">
      <p class="font-semibold text-text-heading"><%= t("rooms.edit.media_strip_label") %></p>
      <% if manage_media %>
        <p class="text-sm text-text-body">
          <%= presenter.media_summary(photo_count: photo_count) %>.
          <%= t("rooms.edit.media_strip_seating_hint") %>
        </p>
      <% else %>
        <p class="text-sm text-text-body"><%= t("rooms.edit.media_admin_only_hint") %></p>
      <% end %>
    </div>
  </div>

  <% if manage_media %>
    <div class="flex flex-wrap gap-2">
      <%= render "rooms/edit/panorama_editor", room: room, form_room: form_room, open: open_media == :panorama %>
      <%= render "rooms/edit/gallery_editor", room: room, form_room: form_room, photo_count: photo_count,
            open: open_media == :gallery %>
    </div>
  <% end %>
</div>
