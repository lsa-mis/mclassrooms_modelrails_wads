<%# locals: (room:, form_room:, open:) %>
<% attached = room.panorama.attached? %>
<%= ui :dialog, id: "panorama-editor", title: t("rooms.edit.panorama_label"), size: :full, open: open do |dialog| %>
  <% dialog.with_trigger do %>
    <button type="button" class="btn-secondary">
      <%= icon(:pencil, size: :sm) %>
      <%= attached ? t("rooms.edit.edit_panorama") : t("rooms.edit.add_panorama") %>
    </button>
  <% end %>

  <%= form_with model: form_room, url: room_path(form_room), method: :patch, multipart: true,
        id: "panorama-editor-form" do |form| %>
    <%= form.error_summary %>
    <div class="grid gap-6 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class="min-w-0">
        <% if attached %>
          <% preview_src = room.flat_panorama.attached? ? rails_storage_proxy_path(room.flat_panorama) : rails_representation_path(room.panorama.variant(:poster)) %>
          <%= render "rooms/edit/media_preview", src: preview_src, alt: room.alt_for(:panorama),
                input_id: form.field_id(:panorama), replace_label: t("rooms.edit.replace_panorama") %>
          <p class="mt-2 text-sm text-text-body">
            <%= t("rooms.edit.updated_ago", time: time_ago_in_words(room.panorama.blob.created_at)) %>
          </p>
        <% else %>
          <p class="text-sm text-text-body"><%= t("rooms.edit.panorama_hint") %></p>
        <% end %>
        <%= render "rooms/edit/media_actions", input_id: form.field_id(:panorama), input_name: form.field_name(:panorama),
              accept: "image/png,image/jpeg,image/webp,image/heic,image/heif",
              remove_form: ("panorama-remove-form" if attached), remove_label: t("rooms.edit.remove_panorama"),
              remove_confirm: t("rooms.edit.remove_panorama_confirm", room: room.display_name) %>
      </div>
      <div class="min-w-0 space-y-4">
        <%= form.text_area :panorama_alt, rows: 3, label: t("rooms.media.alt_label") %>
        <%= form.text_area :panorama_description, rows: 6, label: t("rooms.media.description_label") %>
      </div>
    </div>
  <% end %>

  <% if attached %>
    <%= form_with model: form_room, url: room_path(form_room, return_to: "edit"), method: :patch,
          id: "panorama-remove-form", class: "hidden" do |form| %>
      <%= form.hidden_field :remove_panorama, value: "1", id: nil %>
    <% end %>
  <% end %>

  <% dialog.with_footer do %>
    <button type="button" class="btn-secondary" data-action="click->modal#close"><%= t("rooms.edit.cancel") %></button>
    <%= button_tag t("rooms.edit.save_media"), type: "submit", form: "panorama-editor-form", class: "btn-primary" %>
  <% end %>
<% end %>
