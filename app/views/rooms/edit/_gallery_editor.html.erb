<%# locals: (room:, form_room:, photo_count:, open:) %>
<% persisted_photos = form_room.gallery.select(&:persisted?) %>
<% saved_photos = room.gallery.includes(image_attachment: :blob).index_by(&:id) %>
<%= ui :dialog, id: "gallery-editor", title: t("rooms.edit.gallery_heading"), size: :full, open: open,
      description: media_editor_message(open) do |dialog| %>
  <% dialog.with_trigger do %>
    <button type="button" class="btn-secondary">
      <%= icon(:pencil, size: :sm) %>
      <%= photo_count.positive? ? t("rooms.edit.manage_photos", count: photo_count) : t("rooms.show.add_photos") %>
    </button>
  <% end %>

  <%= form_with model: form_room, url: room_gallery_path(form_room), method: :patch, multipart: true,
        id: "gallery-editor-form",
        data: { controller: "form-reset", action: "turbo:submit-end->form-reset#reset" } do |form| %>
    <%= form.error_summary %>
    <div class="divide-y divide-border">
    <%= form.fields_for :gallery, form_room.gallery_by_position, include_id: false do |gf| %>
      <% gallery_image = gf.object %>
      <% position = gf.index + 1 %>
      <% if gallery_image.persisted? %>
        <% saved_image = saved_photos.fetch(gallery_image.id, gallery_image).image %>
        <div class="grid gap-6 py-6 first:pt-0 last:pb-0 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
          <%= gf.hidden_field :id %>
          <div class="min-w-0" data-controller="media-preview" data-action="change->media-preview#show">
            <%= render "rooms/edit/media_preview",
                  src: rails_representation_path(saved_image.variant(:gallery)),
                  input_id: gf.field_id(:image), replace_label: t("rooms.edit.replace_photo", position: position) %>
            <p class="mt-2 text-sm text-text-body">
              <%= t("rooms.edit.updated_ago", time: time_ago_in_words(saved_image.blob.created_at)) %>
            </p>
            <div class="flex flex-wrap items-end justify-between gap-3">
              <%= render "rooms/edit/media_actions", input_id: gf.field_id(:image), input_name: gf.field_name(:image),
                    accept: "image/png,image/jpeg,image/webp,image/heic,image/heif",
                    upload_label: t("rooms.edit.upload_new_photo"), upload_context: position.to_s,
                    remove_form: "photo-remove-#{gallery_image.id}", remove_label: t("rooms.edit.remove_photo"),
                    remove_context: position.to_s,
                    remove_confirm: t("rooms.edit.remove_photo_confirm", position: position, room: room.display_name) %>
              <div class="w-28">
                <%= gf.number_field :position, label: t("rooms.edit.position_label", position: position), min: 1, required: true %>
              </div>
            </div>
          </div>
          <div class="min-w-0 space-y-4">
            <%= gf.text_area :image_alt, rows: 3, label: t("rooms.media.alt_label") %>
            <%= gf.text_area :image_description, rows: 4, label: t("rooms.media.description_label") %>
          </div>
        </div>
      <% else %>
        <div class="py-6 first:pt-0 last:pb-0">
          <%= gf.hidden_field :position %>
          <%= gf.file_field :image,
                label: t("rooms.edit.gallery_add_label", position: position),
                help: t("rooms.edit.gallery_add_hint"),
                accept: "image/png,image/jpeg,image/webp,image/heic,image/heif" %>
        </div>
      <% end %>
    <% end %>
    </div>
    <% if form_room.gallery.none?(&:new_record?) && form_room.gallery.size >= 5 %>
      <p class="pt-6 text-sm text-text-body"><%= t("rooms.edit.gallery_full_notice") %></p>
    <% end %>
  <% end %>

  <% persisted_photos.each do |photo| %>
    <%= form_with url: room_photo_path(form_room, photo), method: :delete, id: "photo-remove-#{photo.id}", class: "hidden" do %>
    <% end %>
  <% end %>

  <% dialog.with_footer do %>
    <button type="button" class="btn-secondary" data-action="click->modal#close"><%= t("rooms.edit.cancel") %></button>
    <%= button_tag t("rooms.edit.save_media"), type: "submit", form: "gallery-editor-form", class: "btn-primary" %>
  <% end %>
<% end %>
