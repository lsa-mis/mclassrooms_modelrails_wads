<%# locals: (room:, gallery:) %>
<%# One home for room stills: the panorama is the hero, so there is no separate
    "main photo" treatment. UI::Gallery brings its own thumbnails + lightbox. %>
<div class="space-y-3">
  <% if gallery.any? %>
    <%= ui :gallery do |g| %>
      <% gallery.each do |asset| %>
        <% g.with_image(src: rails_representation_path(asset.image.variant(:thumb)),
              alt: asset.alt_for(:image),
              caption: asset.description_for(:image)) %><%# herb:disable erb-no-unused-expressions %>
      <% end %>
    <% end %>
  <% end %>
</div>
