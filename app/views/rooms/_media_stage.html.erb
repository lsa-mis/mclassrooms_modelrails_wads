<%# locals: (room:, presenter:, gallery:, has_pano:, has_photos:) %>
<%# Two-mode stage (2026-08-07 spec): pano default when present, photos one
    chip-click away — progressive disclosure, not tabs. The pano pane keeps
    data-turbo-permanent and is only ever `hidden`, never removed (WebGL
    survival). The chip is the ONLY mode control and does nothing else. %>
<%# gallery/modal only mount when there are photos to browse — mounting
    `modal` with no `[data-modal-target="dialog"]` in scope (pano-only rooms
    never render _photo_frame, the dialog's only source) makes Stimulus log
    a missing-target error on connect and on every Turbo navigation. %>
<section data-testid="media-stage" class="mt-6 relative"
     aria-label="<%= t("rooms.show.media_label") %>"
     data-controller="media-stage<%= " gallery modal" if has_photos %>"
     data-action="gallery:navigated->media-stage#syncFromPopout"
     <%# The badge format lives in one YAML key (rooms.show.photo_badge) so the
         server-rendered first badge and the JS-rendered updates on prev/next
         can never drift apart. We fetch the raw "%{caption} · %{position}"
         template by round-tripping each placeholder's name through itself —
         I18n#interpolate only replaces the %{...} tokens it's given values
         for, so passing the placeholder's own name back yields the literal
         template string. media_stage_controller.js then does the same
         %{caption}/%{position} substitution client-side. %>
     <% if has_photos %>data-media-stage-badge-format-value="<%= t("rooms.show.photo_badge", caption: "%{caption}", position: "%{position}") %>"<% end %>>
  <% if has_pano %>
    <div data-media-stage-target="pano">
      <%= render "rooms/pano_pane", room: room %>
    </div>
  <% end %>

  <% if has_photos %>
    <%= render "rooms/photo_frame", room: room, gallery: gallery,
          start_hidden: has_pano %>
  <% end %>

  <% if has_pano && has_photos %>
    <%= render "rooms/media_chip", gallery: gallery, room: room %>
  <% end %>

  <%# Identity + capacity plate — unchanged from v4 (see git history for the
      mobile/desktop split rationale). %>
  <div class="mt-2 rounded-md bg-surface-raised px-4 py-3
              flex flex-wrap items-end justify-between gap-x-4 gap-y-1
              md:mt-0 md:absolute md:inset-x-0 md:bottom-0 md:rounded-t-none
              md:pointer-events-none md:bg-surface-overlay/90">
    <div class="min-w-0">
      <h1 class="text-xl font-bold text-text-heading"><%= room.display_name %></h1>
      <p class="text-sm text-text-body"><%= room_meta_line(room) %></p>
    </div>
    <div class="text-right shrink-0">
      <span class="sr-only"><%= presenter.capacity_line %></span>
      <span aria-hidden="true">
        <span class="block text-2xl font-bold text-text-heading tabular-nums leading-tight"><%= room.instructional_seat_count.to_i %></span>
        <span class="block text-xs uppercase tracking-wide text-text-body">
          <%= t("rooms.show.seats_unit") %><% if room.ada_seat_count.to_i.positive? %> · <%= t("rooms.row.ada", count: room.ada_seat_count) %><% end %>
        </span>
      </span>
    </div>
  </div>
</section>
