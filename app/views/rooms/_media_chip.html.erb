<%# locals: (gallery:, room:) %>
<%# THE CHIP PATTERN (app-level by decision, spec §3 — do not extract at n=1):
    an opaque surface-overlay plate over an arbitrary raster (same recipe as
    the Load-360 button: deterministic AAA contrast), a media swatch, and
    EXACTLY ONE action — toggling the stage mode. It never opens the popout
    and never navigates. Second consumer (e.g. a Buildings media stage)
    graduates the whole stage pattern to modelrails_ui, not this file alone. %>
<%# Pano-swatch preview path — copied verbatim from _pano_pane's conditional
    (flat render attached wins; otherwise the squashed-equirect :poster). %>
<% pano_swatch_path = if room.flat_panorama.attached?
                        rails_storage_proxy_path(room.flat_panorama)
                      else
                        rails_representation_path(room.panorama.variant(:poster))
                      end %>
<div class="absolute top-3 right-3">
  <button type="button" data-media-stage-target="chipToPhotos" data-testid="media-chip"
          class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-surface-overlay py-1 pl-1 pr-3.5 text-sm font-semibold text-text-body shadow-sm focus-ring"
          data-action="media-stage#showPhotos">
    <%= image_tag rails_representation_path(gallery.first.image.variant(:card)),
          alt: "", class: "h-8 w-11 rounded object-cover" %>
    <%= t("rooms.show.view_photos", count: gallery.size) %>
  </button>
  <button type="button" data-media-stage-target="chipToPano" hidden
          class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-surface-overlay py-1 pl-1 pr-3.5 text-sm font-semibold text-text-body shadow-sm focus-ring"
          data-action="media-stage#showPano">
    <%= image_tag pano_swatch_path, alt: "", class: "h-8 w-11 rounded object-cover" %>
    <%= t("rooms.show.back_to_panorama") %>
  </button>
</div>
