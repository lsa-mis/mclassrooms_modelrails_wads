<%# locals: (room:, presenter:, message:) %>
<% gallery = presenter.stage_photos %>
<%= turbo_stream.replace "room_visibility", method: :morph, partial: "rooms/visibility", locals: { room: room } %>

<%= turbo_stream.update "room_media_view", partial: "rooms/media",
      locals: { room: room, presenter: presenter, gallery: gallery, has_pano: room.panorama.attached?,
                has_photos: gallery.any?, permanent: false, docked: true } %>

<%= turbo_stream.append "toast-pills" do %>
  <%= render "shared/toast_pill", type: :success, message: message %>
<% end %>
