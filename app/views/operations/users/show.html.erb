<% content_for(:title) { @user.full_name } %>
<%= render "shared/settings_page_header", title: @user.full_name, description: @user.email_address %>

<div class="mt-4 flex flex-wrap items-center gap-2">
  <% if @user.operator? %>
    <%= ui :badge, t("operations.users.show.operator"), variant: :soft, tone: :info %>
  <% end %>
  <% if @user.suspended? %>
    <%= ui :badge, t("operations.users.show.suspended"), variant: :soft, tone: :warning %>
  <% end %>
</div>

<%# button_to, not `ui :button href: data-turbo-method:` — without JS a link
    GETs a route with no GET handler, and ui :button can't render a form.
    class: repeats ButtonComponent::COMBOS' two AAA-proven cells
    (btn-secondary, btn-danger). %>
<% if @user.suspended? %>
  <p class="mt-3 text-sm text-text-body">
    <%= t("operations.users.show.suspended_since", time: viewer_local_timestamp(@user.suspended_at)) %>
  </p>
  <%= button_to t("operations.users.show.reinstate"), operations_user_suspension_path(@user),
        method: :delete, class: "btn-secondary mt-3" %>
<% elsif policy([ :operations, @user ]).suspend? %>
  <%= button_to t("operations.users.show.suspend"), operations_user_suspension_path(@user),
        method: :post, class: "btn-danger mt-3",
        form: { data: { turbo_confirm: t("operations.users.show.suspend_confirm") } } %>
<% else %>
  <%# The policy refuses operators; the sentence says why, with an in-prose
      link (not .btn-text, which only reads as a control beside a button). %>
  <p class="mt-3 text-sm text-text-body">
    <%= t("operations.users.show.operator_unsuspendable_html",
          link: link_to(t("operations.users.show.operator_access"), operations_operatorships_path,
                        class: "text-interactive underline hover:no-underline focus-ring rounded")) %>
  </p>
<% end %>

<% if @user.locked? %>
  <p class="mt-3 text-sm text-text-body">
    <%= t("operations.users.show.lockout",
          count: User::MAX_FAILED_ATTEMPTS,
          time: distance_of_time_in_words(Time.current, @user.locked_at + User::LOCK_DURATION)) %>
  </p>
  <%= button_to t("operations.users.show.clear_lockout"), operations_user_lock_path(@user),
        method: :delete, class: "btn-secondary mt-3" %>
<% end %>

<section aria-labelledby="ops-user-memberships" class="mt-6">
  <h2 id="ops-user-memberships" class="text-lg font-semibold text-text-heading"><%= t("operations.users.show.memberships") %></h2>
  <% if @memberships.any? %>
    <%= ui :list_group, class: "mt-3" do %>
      <% @memberships.each do |membership| %>
        <%# The row stays a static li with the link inside it, not a whole-row
            list_group_item href: the badge would then sit inside the <a> and
            join its accessible name. hover:bg-surface: the row is not the
            control, the link is, so it does not highlight — and the gem's
            hover token under an interactive link measures below AAA. %>
        <%= ui :list_group_item, class: "gap-4 hover:bg-surface" do %>
          <%# operated_workspaces (Workspace.kept) can never resolve a discarded
              workspace's slug — link only a kept one, or the operator lands on
              a not-found redirect. %>
          <% if membership.workspace.kept? %>
            <%= link_to membership.workspace.name, operations_workspace_path(membership.workspace), class: "btn-text btn-text-interactive" %>
          <% else %>
            <span><%= membership.workspace.name %> — <%= lifecycle_status_label(membership.workspace) %></span>
          <% end %>
          <%= ui :badge, membership.role.name, variant: :soft, tone: :neutral %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="mt-3">
      <%= render "shared/empty_state", message: t("operations.users.show.no_memberships") %>
    </div>
  <% end %>
</section>
