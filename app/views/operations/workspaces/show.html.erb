<% content_for(:title) { t("operations.area.page_title", name: @workspace.name) } %>
<%# Same header row as the workspaces index: the name line (badge inline, via
    the partial's badges: local) and, opposite it, the one link that is
    navigation rather than a state change. The lock control is not here — it
    closes the page in its own section, below what an operator reads first. %>
<div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
  <%= render "shared/settings_page_header", title: @workspace.name, badges: lifecycle_status_badge(@workspace) %>
  <%= ui :button, t("operations.workspaces.show.view_activity"), variant: :outline, tone: :neutral,
        href: operations_activity_logs_path(workspace: @workspace.slug), class: "whitespace-nowrap" %>
</div>

<%# A plain div, not a named <section>: the heading already outlines it, and a
    landmark per list put five regions on a page with two short lists. The id
    scopes specs to this list. %>
<div id="ops-members">
  <h2 class="text-lg font-semibold text-text-heading"><%= t("operations.workspaces.show.members") %></h2>
  <% if @memberships.any? %>
    <%= ui :list_group, class: "mt-3" do %>
      <% @memberships.each do |membership| %>
        <%= ui :list_group_item, class: "gap-4" do %>
          <span><%= membership.user.full_name %></span>
          <%= ui :badge, membership.role.name, variant: :soft, tone: :neutral %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="mt-3">
      <%= render "shared/empty_state", message: t("operations.workspaces.show.no_members") %>
    </div>
  <% end %>
</div>

<%= render "shared/activity_feed", activities: @activities %>

<%# The one destructive control on the page, last and under its own heading
    with the consequence stated beside it — not the first thing after the
    title. button_to, not `ui :button href: data-turbo-method:` — this app's
    own convention for a destructive confirm, and without JS a link GETs a
    route with no GET handler. ui :button can't fill in: it renders an
    <a>/<button>, never a <form>. class: repeats ButtonComponent::COMBOS'
    own output for the two AAA-proven cells (btn-danger, btn-secondary). %>
<div class="mt-8 border-t border-border pt-6">
  <h2 class="text-lg font-semibold text-text-heading"><%= t("operations.workspaces.show.access") %></h2>
  <% if @workspace.suspended? %>
    <p class="mt-1 text-sm text-text-body">
      <%= t("operations.workspaces.show.locked_since_html",
            time: tag.time(viewer_local_timestamp(@workspace.suspended_at), datetime: @workspace.suspended_at.iso8601)) %>
    </p>
    <%= button_to t("operations.workspaces.show.unsuspend"), operations_workspace_suspension_path(@workspace),
          method: :delete, class: "btn-secondary mt-3" %>
  <% else %>
    <p class="mt-1 text-sm text-text-body"><%= t("operations.workspaces.show.lock_hint") %></p>
    <%= button_to t("operations.workspaces.show.suspend"), operations_workspace_suspension_path(@workspace),
          method: :post, class: "btn-danger mt-3",
          form: { data: { turbo_confirm: t("operations.workspaces.show.suspend_confirm", name: @workspace.name) } } %>
  <% end %>
</div>
