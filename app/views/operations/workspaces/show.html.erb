<% content_for(:title) { @workspace.name } %>
<%# shared/settings_page_header has no slot for inline content beside the
    title, so the lifecycle signal — the design system's badge treatment,
    not prose — needs a small bespoke header; same type scale as the shared
    partial. The badge's own text ("Locked") carries no "this is a status"
    context on its own, so it gets an explicit aria-label rather than
    relying on surrounding text. Built by string concatenation, not an i18n
    %{status} interpolation: lifecycle_status_label already returns a
    translated string, so it doesn't need one. %>
<header class="mb-8">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold text-text-heading"><%= @workspace.name %></h1>
    <%= ui :badge, lifecycle_status_label(@workspace), variant: :soft, tone: :neutral,
          "aria-label": "#{t('operations.workspaces.show.status_prefix')}: #{lifecycle_status_label(@workspace)}" %>
  </div>
  <%# button_to, not `ui :button href: data-turbo-method:` — this app's own
      convention for a destructive confirm, and without JS a link GETs a
      route with no GET handler. ui :button can't fill in: it renders an
      <a>/<button>, never a <form>. class: repeats ButtonComponent::COMBOS'
      own output for the two AAA-proven cells (btn-danger, btn-secondary). %>
  <div class="mt-4">
    <% if @workspace.suspended? %>
      <%= button_to t("operations.workspaces.show.unsuspend"), operations_workspace_suspension_path(@workspace),
            method: :delete, class: "btn-secondary" %>
    <% else %>
      <%= button_to t("operations.workspaces.show.suspend"), operations_workspace_suspension_path(@workspace),
            method: :post, class: "btn-danger",
            form: { data: { turbo_confirm: t("operations.workspaces.show.suspend_confirm") } } %>
    <% end %>
  </div>
</header>

<section aria-labelledby="ops-members-heading" class="mt-6">
  <h2 id="ops-members-heading" class="text-lg font-semibold text-text-heading"><%= t("operations.workspaces.show.members") %></h2>
  <% if @memberships.any? %>
    <%= ui :list_group, class: "mt-3" do %>
      <% @memberships.each do |membership| %>
        <%= ui :list_group_item, class: "gap-4" do %>
          <span><%= membership.user.full_name %></span>
          <%= ui :badge, membership.role.name, variant: :soft, tone: :neutral %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="mt-3">
      <%= render "shared/empty_state", message: t("operations.workspaces.show.no_members") %>
    </div>
  <% end %>
</section>

<%= render "shared/activity_feed", activities: @activities %>
