<% content_for(:title) { t(".title") } %>
<div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
  <%= render "shared/settings_page_header", title: t(".title"), description: t(".description") %>
  <% if @in_progress %>
    <p class="text-sm text-text-body sm:max-w-xs"><%= t(".in_progress") %></p>
  <% else %>
    <%= button_to t("operations.sync_runs.actions.run_now"), operations_sync_runs_path,
          class: "btn-primary whitespace-nowrap",
          data: { turbo_confirm: t(".run_now_confirm") } %>
  <% end %>
</div>

<%= render "sync_runs/summary", latest: @sync_runs.first, inventory: @inventory %>
<%= render "sync_runs/history", sync_runs: @sync_runs, scope: :operations, retry_allowed: !@in_progress %>
