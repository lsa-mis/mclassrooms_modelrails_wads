#!/usr/bin/env ruby
require "fileutils"
require "yaml"
require "shellwords"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # Fork seam: per-clone setup for downstream forks (see /docs/developer/forking).
  # bin/fork records the decisions once in .fork.yml; this applies them in every
  # clone. A teammate cloning an already-forked repo runs only bin/setup — they
  # have no upstream remote and no .env yet — so this is where they get both.
  #
  # The merge=ours driver is deliberately NOT set in the template repo itself:
  # it would silently mis-resolve the template's own PR merges that touch
  # fork-owned paths.
  # Committed and hand-editable, so read defensively: a bad file must not take
  # down every teammate's setup with a Psych backtrace.
  fork_config =
    begin
      File.exist?(".fork.yml") ? (YAML.safe_load_file(".fork.yml") || {}) : {}
    rescue Psych::Exception => e
      abort "bin/setup: .fork.yml is not valid YAML (#{e.message.lines.first.to_s.strip})"
    end

  if fork_config.any? || system("git remote get-url upstream", out: File::NULL, err: File::NULL)
    puts "\n== Fork detected — applying per-clone setup =="

    template_url = fork_config["template_url"]
    unless template_url.nil? || system("git remote get-url upstream", out: File::NULL, err: File::NULL)
      system! "git remote add upstream #{template_url.shellescape}"
      system! "git remote set-url --push upstream DISABLED"
      puts "   upstream remote added (push disabled)"
    end

    system! "git config merge.ours.driver true"

    # Validated here, not just where it was written: .fork.yml is committed and
    # hand-editable, so an unchecked value would propagate a typo into every
    # teammate's .env and surface as an initializer raise at boot with nothing
    # pointing back to this file. Kept in step with config/initializers/tenancy.rb.
    valid_presets = %w[personal shared none]
    preset = fork_config["preset"]
    if preset && !valid_presets.include?(preset)
      abort "bin/setup: .fork.yml records an unknown preset #{preset.inspect} " \
            "(expected #{valid_presets.join('/')}). The app would refuse to boot."
    end

    # Only when unset: a developer's local override of the tenancy mode must
    # survive re-running setup.
    env = File.exist?(".env") ? File.read(".env") : ""
    if preset && !env.match?(/^WORKSPACE_ON_SIGNUP=/)
      lines = [ "WORKSPACE_ON_SIGNUP=#{preset}" ]
      # config/initializers/tenancy.rb raises at boot without the slug.
      lines << "TENANCY_SHARED_WORKSPACE_SLUG=#{fork_config['name']}" if preset == "shared"
      env += "\n" unless env.empty? || env.end_with?("\n")
      File.write(".env", env + lines.join("\n") + "\n")
      puts "   .env ← #{lines.join(', ')} (from .fork.yml)"
    end
  end

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  # If a previous `assets:precompile` run left artifacts in public/assets/,
  # Propshaft prefers the static manifest over dynamic resolution and silently
  # drops any JS file added afterward — see app/docs/developer/troubleshooting.md.
  # Clobber here so a fresh `bin/setup` always heals that state.
  puts "\n== Clearing precompiled assets =="
  system! "bin/rails assets:clobber"

  # assets:clobber is enhanced by tailwindcss-rails to also run
  # tailwindcss:clobber, so the step above deletes app/assets/builds/
  # tailwind.css. `bin/dev` would rebuild it, but --skip-server never gets
  # there — and system specs render unstyled without it, failing every
  # axe-contrast and layout-dependent example at once.
  puts "\n== Building Tailwind CSS =="
  system! "bin/rails tailwindcss:build"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
