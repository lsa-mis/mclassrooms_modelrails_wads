<%# A confirm dialog opened from inside a form dialog — the ordinary reason to stack.
    Native <dialog> supports this: showModal() on a second dialog puts it above the first
    in the top layer, moves the focus trap, and Escape closes only the topmost. %>
<%= render "shared/modal",
      id: "preview-dialog-outer",
      title: "Edit project",
      description: "Change the project name.",
      trigger: "Open form",
      trigger_class: "btn-primary" do %>
  <p class="text-text-body">Project settings would go here.</p>

  <div class="mt-4">
    <%= render "shared/modal",
          id: "preview-dialog-inner",
          title: "Discard changes?",
          description: "This cannot be undone.",
          trigger: "Discard",
          trigger_class: "btn-secondary" do %>
      <p class="text-text-body">The confirm sits above the form it was opened from.</p>
    <% end %>
  </div>
<% end %>
