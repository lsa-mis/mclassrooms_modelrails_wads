#
# graphify reads .gitignore FIRST and this file second, so everything git
# already ignores is excluded for free. List only the deltas: paths git tracks
# that add noise rather than architecture to the graph. Do not paste .gitignore
# in here — a copy adds nothing and rots out of sync (enforced by
# spec/code_smells/template_invariants_spec.rb).

db/migrate/                    # schema.rb already captures current state
config/locales/                # locale strings add nothing to architecture
spec/components/previews/      # Lookbook previews: 508 nodes, near-zero query value
